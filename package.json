{
  "name": "sarvam-voice-desktop",
  "version": "1.0.1",
  "description": "LiveKit, Sarvam and Gemma desktop voice assistant",
  "main": "app/main.cjs",
  "author": "Voice Agent Project",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "build": "electron-builder --win portable --x64",
    "pack": "electron-builder --win dir --x64"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "playwright": "^1.64.1"
  },
  "build": {
    "appId": "local.sarvam.voiceagent",
    "productName": "Sarvam Voice",
    "directories": {
      "output": "release-1.0.1"
    },
    "files": [
      "app/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime"
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false,
      "icon": "assets/icon.ico"
    },
    "artifactName": "Sarvam-Voice-${version}-${arch}.${ext}",
    "asar": true,
    "compression": "store"
  }
}
